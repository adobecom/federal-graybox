{
  "name": "global-navigation",
  "version": "0.0.1",
  "description": "global-navigation for adobe.com",
  "private": true,
  "main": "dist/main.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "check:deps": "npm ls --depth=0 >/dev/null || (echo 'global-navigation dependencies are out of date. Use Node 22 and run npm ci.' && exit 1)",
    "prebuild": "npm run check:deps --silent",
    "build": "node build.js",
    "predev": "npm run check:deps --silent",
    "dev": "./dev.sh",
    "clean": "rm -rf dist",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "test": "web-test-runner 'test/**/*.test.{js,ts}' --node-resolve",
    "test:watch": "npm test -- --watch",
    "test:coverage": "npm test -- --coverage"
  },
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@esm-bundle/chai": "^4.3.4-fix.0",
    "@web/dev-server-esbuild": "^1.0.5",
    "@web/test-runner": "^0.20.2",
    "esbuild": "^0.25.6",
    "eslint": "^9.29.0",
    "lightningcss": "^1.32.0",
    "sinon": "^21.0.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0"
  },
  "dependencies": {
    "dompurify": "^3.4.17"
  }
}
